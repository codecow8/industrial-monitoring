IMAGE_PREFIX=ghcr.io/codecow8/industrial-monitoring
# Use a random hex password: openssl rand -hex 32 (safe in a database URL).
POSTGRES_PASSWORD=replace-with-random-hex
DEMO_USERNAME=demo-admin
# Generate interactively: docker run --rm -it caddy:2-alpine caddy hash-password
# Keep single quotes around the hash to prevent Compose dollar interpolation.
DEMO_PASSWORD_HASH='replace-with-bcrypt-hash'
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
AI_MODEL=
